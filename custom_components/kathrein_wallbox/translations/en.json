  "services": {
    "set_ems_control_enabled": {
      "name": "Set EMS control state",
      "description": "Enable or disable EMS control for this Wallbox.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "enabled": {"name": "Enabled", "description": "Whether EMS control is enabled."}
      }
    },
    "set_relay_matrix": {
      "name": "Set relay matrix",
      "description": "Choose the relay matrix for EMS control.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "value": {"name": "Phase selection", "description": "Relay phases to enable."}
      }
    },
    "set_charging_current": {
      "name": "Set charging current setpoint",
      "description": "Set the charging current requested from the EMS.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "value": {"name": "Current setpoint", "description": "EMS charging current in amps. 0 A pauses charging and grants no charging current."}
      }
    },
    "set_timeout_period": {
      "name": "Set EMS timeout period",
      "description": "Set how long the EMS override remains active.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "value": {"name": "Timeout period", "description": "Timeout in seconds, or off."}
      }
    },
    "set_timeout_fallback_relay_matrix": {
      "name": "Set EMS timeout fallback relay matrix",
      "description": "Choose the relay matrix used when the EMS timeout expires.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "value": {"name": "Fallback relay matrix", "description": "Relay phases to use after timeout."}
      }
    },
    "set_timeout_fallback_current": {
      "name": "Set EMS timeout fallback current",
      "description": "Set the fallback charging current used when the EMS timeout expires.",
      "fields": {
        "entry_id": {"name": "Wallbox", "description": "Wallbox configuration to control."},
        "value": {"name": "Fallback current", "description": "Fallback current in amps. 0 A pauses charging and grants no charging current."}
      }
    }
  },
