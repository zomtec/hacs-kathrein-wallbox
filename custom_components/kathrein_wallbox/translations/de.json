        "entry_id": {"name": "Wallbox", "description": "Zu steuernde Wallbox-Konfiguration."},
        "value": {"name": "Fallback Relaismatrix", "description": "Nach dem Timeout zu verwendende Phasen."}
      }
    },
    "set_timeout_fallback_current": {
      "name": "EMS Timeout Fallback Ladestrom einstellen",
      "description": "Fallback-Ladestrom nach Ablauf des EMS Timeouts einstellen.",
      "fields": {
